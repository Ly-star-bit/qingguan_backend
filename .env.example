MONGO_PASS=luoyu123456
MONGO_DB=qingguan

# 用户名
USER_NAME=
# 密钥
SECRET_KEY=



ACCESS_TOKEN_SECRET_KEY = 
ACCESS_TOKEN_ALGORITHM = 

# skudetail 外部调用使用的固定 Bearer 令牌（原来硬编码在 app/middleware.py 中）；不配置则关闭该通道
SKUDETAIL_STATIC_TOKEN=

# 统一认证登录（见 app/apis/oidc.py）。先在统一认证中心登记应用和网页（机密）客户端，回调地址与 OIDC_REDIRECT_URI 一致
OIDC_ENABLED=false
# 统一认证中心地址，如 https://sso.hubs-scs.com/
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 前端的回调页：https://<本系统前端域名>/login/callback
OIDC_REDIRECT_URI=
# 是否允许内置 admin 账号绑定统一认证（默认不允许，admin 只能用账号密码登录）
OIDC_ALLOW_ADMIN_BINDING=false

# 离职回收（见 app/oidc_events.py）：订阅统一认证中心的 RabbitMQ 事件，员工停用后自动禁用绑定的本系统账号。不配置 HOST 则不订阅
OIDC_EVENTS_HOST=
OIDC_EVENTS_PORT=5672
OIDC_EVENTS_USER=
OIDC_EVENTS_PASSWORD=
OIDC_EVENTS_VHOST=/
# 本系统自己的队列名，不要和别的系统共用
OIDC_EVENTS_QUEUE=qingguan.identity-events
